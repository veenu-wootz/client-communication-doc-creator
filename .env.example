# ── Email (the one delivery path that matters) ───────────────
# Without these the deck is still generated, but nobody receives it.
SMTP_USER=                       # the mailbox the deck is sent from
SMTP_PASSWORD=
SMTP_SERVICE=office365           # office365 | gmail
SMTP_FROM_NAME=                  # display name on the From line. Defaults to "Wootz" —
                                  # override this if SMTP_USER is NOT a wootz.work address
                                  # (e.g. a Gmail fallback), or the mismatch reads as spoofing
                                  # to the recipient's spam filter.
                                  # NOTE: has no effect when SMTP_SERVICE=gmail — Gmail's own
                                  # relay overrides the From name with the Google Account's
                                  # "Send mail as" name (Gmail Settings > Accounts and Import),
                                  # regardless of what's sent here. Only takes effect on office365.
INTERNAL_EMAILS=                 # always-BCC list, comma separated
FALLBACK_EMAIL=                  # used when the payload carries no recipient

# ── LLM enrichment (titles + query/update classification) ────
# Optional. Without a key the service falls back to the form's own values and
# then to a keyword heuristic — see src/input/enrich.js.
ENRICH_PROVIDER=                 # anthropic | openai | off. Blank = whichever key is set
ENRICH_PRECEDENCE=ai-first       # ai-first | strike-first
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── OneDrive / SharePoint via Microsoft Graph (optional) ─────
# Credentials come from an Entra app registration. The destination folder is
# normally sent per submission by Strike (drive_id / folder_item_id); these two
# act as the fallback when a submission doesn't name one.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=                  # fallback drive
GRAPH_FOLDER_ITEM_ID=            # fallback folder

# ── S3 (optional, fallback if OneDrive is unconfigured) ──────
# All four or none. Missing = the upload step is skipped, deck still emailed.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Glide write-back (optional) ──────────────────────────────
# Writes the generated deck's details back into the RFQ row. Needs rfq_row_id
# in the payload. App, table and column ids default to the live Strike table —
# set them only to point at a different one.
GLIDE_TOKEN=                     # required to write anything at all
GLIDE_APP_ID=                    # default: ARzoymvBNIgO6RcvRk7l
GLIDE_TABLE=                     # default: native-table-24696dcc-...
GLIDE_COL_VERSION=               # default YU0gy — RFQ Version Used
                                 # (NOT QZRyl — that is the app's RFQ Folder Drive Item ID)
GLIDE_COL_FILE_ID=               # default RcHZF — Query PPT File ID
GLIDE_COL_FILE_LINK=             # default g0KAH — Query PPT File Link
GLIDE_COL_GENERATED_ON=          # default TjmbZ — Query PPT Generated On
GLIDE_COL_GENERATED_BY=          # default wVeBR — Query PPT Generated By

# ── Branding ─────────────────────────────────────────────────
LOGO_URL=https://res.cloudinary.com/dbwg6zz3l/image/upload/w_300,f_png,q_90/v1773643264/Black_Yellow_kq9kef.png

PORT=3000
